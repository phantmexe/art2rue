{% extends 'base.html.twig' %}

{% block title %}Détail de l'Œuvre{% endblock %}

{% block body %}
    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow">
                    {% if oeuvre.nomFichier and oeuvre.nomFichier != '' %}
                        <img src="{{ asset('uploads/photos/' ~ oeuvre.nomFichier) }}" class="card-img-top" alt="{{ oeuvre.titre }}" style="max-height: 400px; object-fit: cover;">
                    {% endif %}

                    <div class="card-body">
                        <h1 class="card-title mb-3">{{ oeuvre.titre }}</h1>

                        <ul class="list-group list-group-flush mb-4">
                            <li class="list-group-item">
                                <strong>Lieu :</strong> 📍 {{ oeuvre.lieu }}
                            </li>
                            <li class="list-group-item">
                                <strong>Date de création :</strong> {{ oeuvre.dateCreation ? oeuvre.dateCreation|date('d/m/Y') : 'Non renseignée' }}
                            </li>
                            <li class="list-group-item">
                                <strong>Description :</strong> {{ oeuvre.description|default('Aucune description') }}
                            </li>
                            <li class="list-group-item">
                                <strong>Statut :</strong>
                                {% if oeuvre.estDetruite %}
                                    <span class="badge bg-danger">Détruite</span>
                                {% else %}
                                    <span class="badge bg-success">Intacte</span>
                                {% endif %}
                            </li>
                            <li class="list-group-item">
                                <strong>Techniques :</strong>
                                {% if oeuvre.techniques|length > 0 %}
                                    <div class="mt-2">
                                        {% for technique in oeuvre.techniques %}
                                            <span class="badge bg-info text-dark me-1">{{ technique.nom }}</span>
                                        {% endfor %}
                                    </div>
                                {% else %}
                                    <span class="text-muted">Aucune technique associée</span>
                                {% endif %}
                            </li>
                        </ul>

                        <div class="d-flex justify-content-between align-items-center">
                            <a href="{{ path('app_oeuvre_index') }}" class="btn btn-secondary">Retour à la liste</a>

                            <div class="d-flex gap-2 align-items-center">
                                <a href="{{ path('app_oeuvre_edit', {'id': oeuvre.id}) }}" class="btn btn-warning">Modifier</a>
                                {{ include('oeuvre/_delete_form.html.twig') }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
